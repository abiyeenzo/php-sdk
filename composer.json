{
    "name": "camerpay/php-sdk",
    "description": "Official PHP SDK for CamerPay - Mobile Money, cards and PayPal payments for Cameroon.",
    "type": "library",
    "keywords": [
        "camerpay",
        "payment",
        "mobile-money",
        "orange-money",
        "mtn-momo",
        "cameroon",
        "stripe",
        "paypal",
        "api",
        "sdk"
    ],
    "homepage": "https://camerpay.biz",
    "license": "MIT",
    "authors": [
        {
            "name": "CamerPay",
            "email": "contact@camerpay.biz",
            "homepage": "https://camerpay.biz"
        }
    ],
    "support": {
        "issues": "https://github.com/camerpay/php-sdk/issues",
        "docs": "https://camerpay.biz/docs",
        "email": "contact@camerpay.biz"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "CamerPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CamerPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8",
        "audit": "composer audit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
